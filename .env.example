# Frontend / backend deployment wiring
# In production, set the socket URL to the public backend origin or same-origin proxy.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:4001

# Socket bridge for server-side emits
SOCKET_BRIDGE_URL=http://127.0.0.1:4001/internal/socket/emit
SOCKET_BRIDGE_SECRET=replace-with-a-long-random-secret

# Socket server CORS origin should match the frontend origin that loads the app.
SOCKET_CORS_ORIGIN=http://localhost:4028

# Required production secrets
# MESSMATE_JWT_SECRET=replace-with-a-long-random-secret
# JWT_SECRET=replace-with-a-long-random-secret

# Database connection used by server/config/db.js
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-database-password
DB_NAME=messmate
